# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by scripts/seed.mjs, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase project settings → Database → Connection string (URI).
# Used to apply supabase/migrations/0001_init.sql.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
